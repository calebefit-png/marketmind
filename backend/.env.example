# Application
APP_NAME=MarketMind AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL / TimescaleDB (never commit real credentials)
DATABASE_URL=postgresql+asyncpg://marketmind:change-me@localhost:5432/marketmind
DATABASE_URL_SYNC=postgresql://marketmind:change-me@localhost:5432/marketmind

# Optional Redis
REDIS_URL=redis://localhost:6379/0

# Public market-data endpoints
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com/api/v3
BCB_SGS_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs.{code}/dados

# Gmail API OAuth 2.0 (nunca use senha Gmail, SMTP, Service Account ou tokens reais neste arquivo)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=replace-after-authorizing-the-google-account
GMAIL_SENDER_EMAIL=alerts@your-domain.example
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
GMAIL_ADMIN_SECRET=replace-with-a-long-random-admin-secret
# Produção Render: https://marketmind-l3kg.onrender.com/auth/gmail/callback
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
GMAIL_STATE_MAX_AGE_SECONDS=600

# Telegram Bot API (não versione token real; configure os valores somente no ambiente seguro)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Protege somente endpoints administrativos de notificações.
ADMIN_NOTIFICATION_SECRET=replace-with-a-long-random-notification-secret
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_CHAT_ID=replace-with-private-chat-or-group-id
# Gmail é opcional e não participa da entrega padrão.
ALERT_EMAIL_RECIPIENTS=
ALERT_DEFAULT_CHANNELS=telegram
ALERT_DEFAULT_COOLDOWN_SECONDS=1800
ALERT_WORKER_TECHNICAL_INTERVAL_SECONDS=300
ALERT_WORKER_MACRO_INTERVAL_SECONDS=900
TELEGRAM_MIN_SEND_INTERVAL_SECONDS=1.0
ALERT_PRICE_WINDOW_SECONDS=900
ALERT_PRICE_MOVE_THRESHOLD_PCT=2.5
ALERT_RSI_OVERBOUGHT=70
ALERT_RSI_OVERSOLD=30
ALERT_VOLUME_SPIKE_MULTIPLIER=2.0
ALERT_SELIC_CHANGE_THRESHOLD=0.01
ALERT_PROBABILITY_CHANGE_THRESHOLD=0.15

# Comma-separated origins; use exact production frontend origin(s)
CORS_ORIGINS=http://localhost:3000
