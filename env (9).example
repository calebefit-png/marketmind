# Database
DATABASE_URL=postgresql+asyncpg://marketmind:marketmind_secret@localhost:5432/marketmind
DATABASE_URL_SYNC=postgresql://marketmind:marketmind_secret@localhost:5432/marketmind

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
APP_DEBUG=true
APP_NAME=MarketMind AI
API_V1_PREFIX=/api/v1

# External APIs
